    "android-play-services": {
      "auto": false,
      "mirrors": "device-tests-manual.yml:android-play-services-emulator",
      "runner": "ubuntu-24.04",
      "timeout": 60,
      "setup": {
        "free_disk": true,
        "flutter": true,
        "pub_get": ["example/play_services_test_host"],
        "android": {"api": 34, "target": "google_apis_playstore", "ram": "4096M", "cores": 2, "downloads": "play-services-test-host", "packages": "emulator system-images;android-34;google_apis_playstore;x86_64"}
      },
      "cwd": "example/play_services_test_host",
      "env": {
        "ANDROID_TEST_LAUNCH_ATTEMPTS": "2",
        "ANDROID_TEST_ATTEMPTS": "1",
        "ANDROID_TEST_LOG_DIR": "{logdir}",
        "ANDROID_TEST_INSTALL_FIRST": "build/app/outputs/flutter-apk/app-debug.apk"
      },
      "prepare": [
        "for attempt in 1 2 3; do flutter build apk --debug 2>&1 | tee \"$RUNNER_TEMP/host-build.log\"; rc=${PIPESTATUS[0]}; [ \"$rc\" -eq 0 ] && break; if grep -q 'preparing SDK package NDK' \"$RUNNER_TEMP/host-build.log\"; then echo \"::warning::the NDK download broke off in attempt $attempt (rc=$rc)\"; rm -rf \"$ANDROID_HOME\"/ndk/* \"$ANDROID_HOME\"/.temp; elif ! bash ../../scripts/gradle_not_found.sh \"$RUNNER_TEMP/host-build.log\"; then exit \"$rc\"; fi; done; [ \"$rc\" -eq 0 ] || exit \"$rc\"",
        "settle() { for i in $(seq 1 36); do [ \"$(adb -s emulator-5554 shell dumpsys package installs | sed -n '/Active install sessions/,/Finalized install sessions/p' | grep -c mCommitted=true)\" = 0 ] && break; echo 'waiting for an install that is under way'; sleep 5; done; timeout 300 adb -s emulator-5554 shell am wait-for-broadcast-idle; }",
        "ready=0; end=$(( $(date +%s) + 600 )); while [ \"$(date +%s)\" -lt \"$end\" ]; do timeout 30 adb -s emulator-5554 shell content query --uri content://com.google.android.gms.chimera/api/com.google.android.gms.tflite_dynamite | grep -q ' version=[1-9]' && ready=1 && break; echo 'waiting for Play services to download the runtime module'; sleep 5; done",
        "[ \"$ready\" = 1 ] || { echo '::error::Play services never delivered tflite_dynamite in 10 min'; exit 1; }",
        "adb -s emulator-5554 shell pm disable-user --user 0 com.android.vending || echo '::warning::could not disable the Play Store, a Play services update can still end a run'",
        "settle"
      ],
      "files": [
        {"path": "example/play_services_test_host/integration_test/play_services_runtime_test.dart", "args": ["--timeout", "900s"]},
        {
          "path": "example/play_services_test_host/integration_test/auto_runtime_test.dart",
          "args": ["--dart-define=FLUTTER_LITERT_EXPECT_RUNTIME=playServices", "--timeout", "600s"],
          "env": {"ORG_GRADLE_PROJECT_flutterLitert.runtime": "auto", "ANDROID_TEST_ATTEMPT_LIMIT": "900"},
          "build_minutes": 1.2
        }
      ],
      "command": ["bash", "../../scripts/android_flutter_test.sh", "{file}", "{args}", "--file-reporter", "json:{report}"],
      "run_timeout": 30,
      "fixed_minutes": 6,
      "build_minutes": 0.6,
      "iteration_minutes": 0,
      "run_minutes": 0.3
    },
